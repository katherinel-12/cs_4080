print "The 'Stress Test' (Allocation Pressure)";
var i = 0;
while (i < 100000) {
  var a = "iteration " + "number"; // Allocates new strings
  i = i + 1;
}
print "Stress test passed!";

print "";
print "The Root-Preservation Test";
var longString = "initial";
for (var i = 0; i < 10; i = i + 1) {
  // Every iteration creates many temporary strings that should be collected
  // 'longString' must survive every single GC cycle
  longString = longString + " " + "extra content";
}
print longString;

print "";
print "The Closure & Upvalue Test";
var closure;
{
  var x = "captured value";
  fun getX() {
    return x;
  }
  closure = getX;
} // 'x' goes out of scope here, but is held by 'closure'

// Force many GCs to try and sweep the string "captured value"
for (var i = 0; i < 50; i = i + 1) {
  var temp = "filling up memory...";
}
print closure(); // Should still print "captured value"